# .gcloudignore
# This file specifies files that should not be uploaded to Google Cloud
# when using gcloud commands like 'gcloud app deploy' or 'gcloud functions deploy'.

.gcloudignore
.git
.gitignore

# Node.js
node_modules/
npm-debug.log*
coverage/

# Next.js
frontend/.next/
frontend/out/
frontend/coverage/

# Rust
backend/target/
backend/coverage/

# Environment files
.env
.env.*
*.local

# System
.DS_Store
